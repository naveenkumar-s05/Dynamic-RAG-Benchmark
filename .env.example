# =============================================================================
# Dynamic RAG Benchmark - example environment file
# Copy to ".env" and edit. NEVER commit a real .env or real API keys.
# All values are OPTIONAL. Retrieval + benchmarking work with no LLM at all.
# =============================================================================

# --- Embedding model ---------------------------------------------------------
# Any sentence-transformers model id. all-MiniLM-L6-v2 is small and fast (384d).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Force offline mode once the model is cached (1 = no network calls).
HF_HUB_OFFLINE=0

# --- Retrieval defaults ------------------------------------------------------
DEFAULT_TOP_K=5
# dense | bm25 | hybrid
DEFAULT_RETRIEVAL_MODE=dense

# --- Optional LLM generation -------------------------------------------------
# provider: none | openai | ollama
# "none" keeps the app in retrieval-only mode (no external calls).
LLM_PROVIDER=none

# OpenAI-compatible endpoint (works with OpenAI, Azure-style gateways, LM Studio,
# vLLM, Together, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local Ollama server
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Optional OCR ------------------------------------------------------------
# Path to the tesseract executable. Leave empty to rely on PATH.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- Safety ------------------------------------------------------------------
# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_MB=25
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
